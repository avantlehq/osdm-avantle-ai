{
  "name": "osdm-platform",
  "version": "1.0.0",
  "private": true,
  "description": "OSDM 3.2 compliant rail booking distributor API with mock European rail data",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:api": "npm run dev --workspace=apps/osdm-api",
    "test": "npm run test --workspaces",
    "lint": "next lint || echo 'Linting skipped'",
    "type-check": "npm run type-check --workspaces",
    "db:migrate": "cd infra/prisma && npx prisma migrate dev",
    "db:generate": "cd infra/prisma && npx prisma generate",
    "docker:up": "cd infra && docker-compose up -d",
    "docker:down": "cd infra && docker-compose down",
    "codegen": "npm run codegen --workspace=packages/osdm-schema"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "next": "^15.5.12",
    "prettier": "^3.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/avantlehq/osdm-avantle-ai.git"
  },
  "keywords": [
    "osdm",
    "rail",
    "booking",
    "transport",
    "api"
  ],
  "author": "Avantle.ai",
  "license": "UNLICENSED"
}
